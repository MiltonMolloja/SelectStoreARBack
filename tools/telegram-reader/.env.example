# ── Telegram Client API ──────────────────────────
# Obtener en https://my.telegram.org → API development tools
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# Nombre/ID del grupo o canal a monitorear
# Puede ser el username (@netshoparg) o el ID numérico (-1001234567890)
TELEGRAM_GROUP=NetShop ARG

# ── SelectStoreAR Backend ────────────────────────
# URL del endpoint de sync
API_BASE_URL=http://localhost:5012
API_ADMIN_TOKEN=eyJhbGciOiJIUz...

# ── Configuración ────────────────────────────────
# Cada cuántas horas revisar mensajes nuevos (0 = una sola vez y sale)
CHECK_INTERVAL_HOURS=4

# Cuántas horas hacia atrás buscar mensajes (default: 24)
LOOKBACK_HOURS=24
